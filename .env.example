# Backend
DATABASE_URL="postgresql://meupaciente:meupaciente@localhost:5432/meupaciente?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
# Origens permitidas no CORS, separadas por vírgula. Sem a variável = libera todas (dev).
CORS_ORIGIN="http://localhost:5173"
# E-mails que podem criar conta, separados por vírgula (ADR-010). Sem a variável = cadastro
# aberto (dev). Em produção, defina sempre: senão qualquer pessoa cria conta.
SIGNUP_ALLOWED_EMAILS=""
# Base pública das URLs de fotos gravadas no disco local (desenvolvimento).
# Sem a variável = http://localhost:$PORT. Com o Vercel Blob (produção), não é usada.
PUBLIC_URL="http://localhost:3000"
# Vercel Blob, onde ficam as fotos em produção (ADR-007): ao conectar o Blob ao projeto, a
# Vercel põe as credenciais sozinha. Vazio = disco local. Para testar o Blob no computador,
# cole aqui o token do Blob (painel da Vercel → Storage → o Blob → .env.local).
BLOB_READ_WRITE_TOKEN=""
# Endereço do app (frontend): base do link de redefinição de senha enviado por e-mail.
APP_URL="http://localhost:5173"
# E-mail de recuperação de senha (ADR-011): usa o SMTP; sem SMTP_HOST, o Resend; sem nenhum
# dos dois, o e-mail só aparece no log do backend.
# Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=465, SMTP_USER = o endereço da conta criada para o
# app e SMTP_PASSWORD = a senha de app dela (16 letras, sem espaços). Nunca a senha normal.
# Local: o Mailpit do docker compose recebe tudo com SMTP_HOST="localhost" e SMTP_PORT=1025
# (usuário e senha quaisquer); as mensagens aparecem em http://localhost:8025.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
# Chave da API do Resend: só entrega para qualquer e-mail com domínio próprio verificado nele.
RESEND_API_KEY=""
# Remetente. Vazio: "MeuPaciente <SMTP_USER>" no SMTP (no Gmail, o endereço tem de ser o da
# conta) ou o de teste do Resend, que só entrega para o e-mail da conta Resend.
EMAIL_FROM=""
# Segredo que o Vercel Cron envia à limpeza diária de tokens (GET /v1/cron/token-cleanup, ADR-006).
# Gere com `openssl rand -hex 32`. Sem ele, a rota recusa todo mundo.
CRON_SECRET=""

# Frontend
VITE_API_URL="http://localhost:3000/v1"
