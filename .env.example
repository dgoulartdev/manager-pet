# Backend
DATABASE_URL="postgresql://meupaciente:meupaciente@localhost:5432/meupaciente?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
# Origens permitidas no CORS, separadas por vírgula. Sem a variável = libera todas (dev).
CORS_ORIGIN="http://localhost:5173"
# Base pública usada para montar URLs de fotos de pacientes (storage local, MVP).
# Sem a variável = http://localhost:$PORT. Em produção, a URL pública do backend.
PUBLIC_URL="http://localhost:3000"
# Endereço do app (frontend): base do link de redefinição de senha enviado por e-mail.
APP_URL="http://localhost:5173"
# Chave da API do Resend. Sem ela, o e-mail de recuperação só aparece no log do backend.
RESEND_API_KEY=""
# Remetente. Sem domínio verificado no Resend, use o de teste (só entrega para o e-mail da conta).
EMAIL_FROM="MeuPaciente <onboarding@resend.dev>"

# Frontend
VITE_API_URL="http://localhost:3000/v1"
